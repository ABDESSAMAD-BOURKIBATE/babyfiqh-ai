# Copy this file to .env.local and set your real keys
# Keep .env.local out of version control (it is ignored by .gitignore)

# Gemini / Google GenAI API key
GEMINI_API_KEY=your_gemini_api_key_here

# WebSocket live proxy port (server)
LIVE_PROXY_PORT=3001

# If you want the Express server to NOT serve the static files (e.g. when using a separate static host), set:
# SERVE_STATIC=false
